{
  "title": "Custom Feeds — Performance Impact",
  "uid": "custom-feeds-perf",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["mastodon", "custom-feeds"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Feed Activity",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 2,
      "title": "Feed inserts / sec  (standard vs algorithmic)",
      "description": "Rate of statuses inserted into or enqueued for custom feeds. Compare standard (immediate push) vs algorithmic (pending queue enqueue) to see relative volume.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(ruby_custom_feed_inserts_total{feed_type=\"standard\"}[5m])",
          "legendFormat": "Standard feeds",
          "refId": "A"
        },
        {
          "expr": "rate(ruby_custom_feed_inserts_total{feed_type=\"algorithmic\"}[5m])",
          "legendFormat": "Algorithmic feeds",
          "refId": "B"
        },
        {
          "expr": "rate(ruby_sidekiq_jobs_total{job_name=\"FeedInsertWorker\"}[5m])",
          "legendFormat": "Home feed (baseline)",
          "refId": "C"
        }
      ]
    },

    {
      "id": 3,
      "title": "Algorithmic candidate outcomes",
      "description": "What happens to each candidate dequeued by AlgorithmicFeedWorker. 'Promoted' = reached the user's feed; others = dropped at various gates.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 1, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(ruby_custom_feed_algo_candidates_total{result=\"promoted\"}[5m])",
          "legendFormat": "Promoted to feed",
          "refId": "A"
        },
        {
          "expr": "rate(ruby_custom_feed_algo_candidates_total{result=\"filtered_pipeline\"}[5m])",
          "legendFormat": "Filtered by pipeline",
          "refId": "B"
        },
        {
          "expr": "rate(ruby_custom_feed_algo_candidates_total{result=\"filtered_score\"}[5m])",
          "legendFormat": "Filtered by score",
          "refId": "C"
        },
        {
          "expr": "rate(ruby_custom_feed_algo_candidates_total{result=\"filtered_min_signals\"}[5m])",
          "legendFormat": "Filtered — not enough signals yet",
          "refId": "D"
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "Worker Execution Cost  (CPU proxy)",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 4,
      "title": "Sidekiq job duration p99  (custom feed workers vs home)",
      "description": "p99 execution time per job class.  The delta between the custom feed workers and FeedInsertWorker is the marginal cost per status pushed to a custom feed.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "ruby_sidekiq_job_duration_seconds{job_name=\"CustomFeeds::FeedInsertWorker\",quantile=\"0.99\"}",
          "legendFormat": "Feed Insert",
          "refId": "A"
        },
        {
          "expr": "ruby_sidekiq_job_duration_seconds{job_name=\"CustomFeeds::PullSourceIngestWorker\",quantile=\"0.99\"}",
          "legendFormat": "Pull Source Ingest",
          "refId": "B"
        },
        {
          "expr": "ruby_sidekiq_job_duration_seconds{job_name=\"CustomFeeds::TimeBasedRemovalWorker\",quantile=\"0.99\"}",
          "legendFormat": "Time-based Removal",
          "refId": "C"
        },
        {
          "expr": "ruby_sidekiq_job_duration_seconds{job_name=\"CustomFeeds::StatsCollectorWorker\",quantile=\"0.99\"}",
          "legendFormat": "Stats Collector",
          "refId": "D"
        },
        {
          "expr": "ruby_sidekiq_job_duration_seconds{job_name=\"Recommendations::AlgorithmicFeedWorker\",quantile=\"0.99\"}",
          "legendFormat": "Algorithmic Feed",
          "refId": "E"
        },
        {
          "expr": "ruby_sidekiq_job_duration_seconds{job_name=\"FeedInsertWorker\",quantile=\"0.99\"}",
          "legendFormat": "Home Feed Insert (baseline)",
          "refId": "F"
        }
      ]
    },

    {
      "id": 5,
      "title": "Sidekiq queue latency  (custom feed queues)",
      "description": "How long jobs sit in queue before being picked up.  High latency on 'push' or 'pull' indicates the workers are falling behind.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "ruby_sidekiq_queue_latency_seconds{queue=\"push\"}",
          "legendFormat": "Push queue",
          "refId": "A"
        },
        {
          "expr": "ruby_sidekiq_queue_latency_seconds{queue=\"pull\"}",
          "legendFormat": "Pull queue",
          "refId": "B"
        },
        {
          "expr": "ruby_sidekiq_queue_latency_seconds{queue=\"default\"}",
          "legendFormat": "Default queue",
          "refId": "C"
        },
        {
          "expr": "ruby_sidekiq_queue_latency_seconds{queue=\"scheduler\"}",
          "legendFormat": "Scheduler queue",
          "refId": "D"
        }
      ]
    },

    {
      "id": 11,
      "type": "row",
      "title": "Redis Memory  (feed storage cost)",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 6,
      "title": "Feed Redis memory by type",
      "description": "Estimated bytes occupied by feed keys per type.  Home feeds are the baseline; custom feeds are the marginal cost.  Sampled every 5 minutes by StatsCollectorWorker.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "ruby_custom_feed_redis_memory_bytes{feed_type=\"home\"}",
          "legendFormat": "Home feeds",
          "refId": "A"
        },
        {
          "expr": "ruby_custom_feed_redis_memory_bytes{feed_type=\"standard\"}",
          "legendFormat": "Standard custom feeds",
          "refId": "B"
        },
        {
          "expr": "ruby_custom_feed_redis_memory_bytes{feed_type=\"algorithmic_pending\"}",
          "legendFormat": "Algorithmic pending queue",
          "refId": "C"
        }
      ]
    },

    {
      "id": 7,
      "title": "Active feed key count by type",
      "description": "Number of Redis keys per feed type.  Multiply home count × memory-per-key to estimate per-user cost; compare to custom count to get the overhead ratio.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "ruby_custom_feed_redis_feed_count{feed_type=\"home\"}",
          "legendFormat": "Home feeds",
          "refId": "A"
        },
        {
          "expr": "ruby_custom_feed_redis_feed_count{feed_type=\"standard\"}",
          "legendFormat": "Standard custom feeds",
          "refId": "B"
        },
        {
          "expr": "ruby_custom_feed_redis_feed_count{feed_type=\"algorithmic_pending\"}",
          "legendFormat": "Algorithmic pending queue",
          "refId": "C"
        }
      ]
    },

    {
      "id": 12,
      "type": "row",
      "title": "PostgreSQL Storage  (disk cost)",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 8,
      "title": "Custom feed table sizes  (table + indexes)",
      "description": "pg_total_relation_size for each custom feed table.  recommendation_signals grows with user interactions; custom_feed_steps scales with number of configured feeds.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 16, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "ruby_custom_feed_pg_table_bytes{table_name=\"custom_feed_configs\"}",
          "legendFormat": "Feed configs",
          "refId": "A"
        },
        {
          "expr": "ruby_custom_feed_pg_table_bytes{table_name=\"custom_feed_steps\"}",
          "legendFormat": "Feed steps",
          "refId": "B"
        },
        {
          "expr": "ruby_custom_feed_pg_table_bytes{table_name=\"custom_feed_pull_cursors\"}",
          "legendFormat": "Pull cursors",
          "refId": "C"
        },
        {
          "expr": "ruby_custom_feed_pg_table_bytes{table_name=\"recommendation_signals\"}",
          "legendFormat": "Recommendation signals",
          "refId": "D"
        }
      ]
    },

    {
      "id": 9,
      "title": "Signals recorded / hour",
      "description": "Rate of recommendation signal records written by SignalWorker.  Higher rate = more algorithmic feed data being built up.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(ruby_recommendation_signal_records_total{signal_type=\"tag\"}[5m])) * 3600",
          "legendFormat": "Tag affinity",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ruby_recommendation_signal_records_total{signal_type=\"account\"}[5m])) * 3600",
          "legendFormat": "Account affinity",
          "refId": "B"
        },
        {
          "expr": "sum(rate(ruby_recommendation_signal_records_total{signal_type=\"domain\"}[5m])) * 3600",
          "legendFormat": "Domain affinity",
          "refId": "C"
        }
      ]
    },

    {
      "id": 20,
      "type": "row",
      "title": "Pull Source & Score Distribution",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 21,
      "title": "Algo score distribution  (p50 / p95 of posts reaching pipeline)",
      "description": "Affinity scores of posts that pass the score threshold and reach the pipeline filter. p50 = median quality; p95 = top-end quality. Rising p50 means the signal data is maturing.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(ruby_custom_feed_algo_score_bucket[10m]))",
          "legendFormat": "p50 score",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(ruby_custom_feed_algo_score_bucket[10m]))",
          "legendFormat": "p95 score",
          "refId": "B"
        },
        {
          "expr": "rate(ruby_custom_feed_algo_score_sum[10m]) / rate(ruby_custom_feed_algo_score_count[10m])",
          "legendFormat": "mean score",
          "refId": "C"
        }
      ]
    },

    {
      "id": 22,
      "title": "Pull source: posts fetched / sec",
      "description": "Rate of posts fetched from remote sources by PullSourceIngestWorker, by feed type. Includes all fetch rounds (retries). Compare to inserts rate to see filter efficiency.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 37, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(ruby_custom_feed_pull_source_fetched_total{feed_type=\"standard\"}[5m])",
          "legendFormat": "Standard feeds",
          "refId": "A"
        },
        {
          "expr": "rate(ruby_custom_feed_pull_source_fetched_total{feed_type=\"algorithmic\"}[5m])",
          "legendFormat": "Algorithmic feeds",
          "refId": "B"
        }
      ]
    },

    {
      "id": 23,
      "title": "Pull source: retry attempt distribution",
      "description": "How many fetch rounds each PullSourceIngestWorker run needed. 'attempts=1' = no retry needed; '4' = hit max retries. High proportion of 4s means the feed filter is very aggressive.",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 37, "w": 6, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(ruby_custom_feed_pull_source_runs_total{attempts=\"1\"}[10m])",
          "legendFormat": "1 attempt (no retry)",
          "refId": "A"
        },
        {
          "expr": "rate(ruby_custom_feed_pull_source_runs_total{attempts=\"2\"}[10m])",
          "legendFormat": "2 attempts",
          "refId": "B"
        },
        {
          "expr": "rate(ruby_custom_feed_pull_source_runs_total{attempts=\"3\"}[10m])",
          "legendFormat": "3 attempts",
          "refId": "C"
        },
        {
          "expr": "rate(ruby_custom_feed_pull_source_runs_total{attempts=\"4\"}[10m])",
          "legendFormat": "4 attempts (max retries)",
          "refId": "D"
        }
      ]
    },

    {
      "id": 13,
      "type": "row",
      "title": "System Resources  (server-wide view)",
      "gridPos": { "x": 0, "y": 45, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 14,
      "title": "Server CPU usage %",
      "description": "Overall server CPU.  Correlate spikes with custom feed worker job rates above to attribute CPU cost.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 46, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2 }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU %",
          "refId": "A"
        }
      ]
    },

    {
      "id": 15,
      "title": "Redis total memory used",
      "description": "redis_memory_used_bytes from redis_exporter.  Watch for growth as feeds accumulate posts.",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 46, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Total Redis memory",
          "refId": "A"
        },
        {
          "expr": "redis_memory_used_bytes - sum(ruby_custom_feed_redis_memory_bytes)",
          "legendFormat": "Non-feed memory",
          "refId": "B"
        }
      ]
    },

    {
      "id": 16,
      "title": "Sidekiq process RSS",
      "description": "ruby_rss{type=\"sidekiq\"} from prometheus_exporter.  Should be stable; growth indicates a memory leak.",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 46, "w": 8, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "ruby_rss{type=\"sidekiq\"}",
          "legendFormat": "Sidekiq RSS",
          "refId": "A"
        }
      ]
    }
  ]
}
